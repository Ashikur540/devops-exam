{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRAuthTokenAccountLevelOnly",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ECRPushToNotesApiRepoOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": "arn:aws:ecr:ap-southeast-1:<ACCOUNT_ID>:repository/ashik-notes-api"
    },
    {
      "Sid": "UpdateNotesEcsServiceOnly",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:ap-southeast-1:<ACCOUNT_ID>:service/ashik-notes-cluster/ashik-notes-svc"
    }
  ]
}
