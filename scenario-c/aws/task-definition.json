{
  "family": "ashik-notes-task",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "postgres",
      "image": "postgres:16-alpine",
      "essential": true,
      "environment": [
        { "name": "POSTGRES_DB", "value": "notes" },
        { "name": "POSTGRES_PASSWORD", "value": "notespass" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "pg_isready -U postgres"],
        "interval": 5,
        "timeout": 3,
        "retries": 10,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ashik-notes",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "postgres"
        }
      }
    },
    {
      "name": "app",
      "image": "<ACCOUNT_ID>.dkr.ecr.ap-southeast-1.amazonaws.com/ashik-notes-api:v1",
      "essential": true,
      "portMappings": [
        { "containerPort": 3000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DATABASE_URL", "value": "postgresql://postgres:notespass@localhost:5432/notes" },
        { "name": "PORT", "value": "3000" },
        { "name": "APP_VERSION", "value": "v1" }
      ],
      "dependsOn": [
        { "containerName": "postgres", "condition": "HEALTHY" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q --spider http://localhost:3000/healthz || exit 1"],
        "interval": 10,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ashik-notes",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
